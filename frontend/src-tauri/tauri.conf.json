{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JasaMarga Toll System",
  "version": "1.0.0",
  "identifier": "com.jasamarga.tollsystem",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cross-env TAURI_BUILD=1 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sistem Gerbang Tol Jasa Marga",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' ws://localhost:8000 http://localhost:8000 ipc: http://ipc.localhost; media-src 'self' mediastream: blob:; img-src 'self' data: blob: asset: tauri:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
