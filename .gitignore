# Vehicle Classification Project - .gitignore

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.env
.eggs/

# Virtual environments
ai/venv/
backend/venv/
venv/
.venv/

# ── YOLOv8 / Training ────────────────────────────────────
ai/runs/
backend/models/*.pt
backend/models/*.onnx
backend/uploads/

# ── Node.js / Next.js ────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/out/

# ── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Tauri / Rust build artifacts ─────────────────────────
frontend/src-tauri/target/
frontend/src-tauri/gen/
# Cargo build dir di luar project (C:\cargo-build\)
# (tidak perlu di-ignore karena di luar repo)

# ── PyInstaller output (terlalu besar untuk GitHub) ──────
backend/build/
backend/dist/
backend/*.spec.bak

# ── Backend binary dist (894MB — jangan di-push) ─────────
frontend/backend-dist/_internal/
frontend/backend-dist/backend.exe
# Tapi keep .gitkeep agar folder tetap ada di repo
!frontend/backend-dist/.gitkeep
backend-dist/_internal/
backend-dist/backend.exe
!backend-dist/.gitkeep
